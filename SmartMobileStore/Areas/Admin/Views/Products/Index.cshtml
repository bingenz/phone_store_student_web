@model List<Product>
@{ ViewData["Title"] = "Quản lý sản phẩm"; }
<main class="container page"><h2>Quản lý sản phẩm</h2><a asp-action="Edit" class="btn btn-primary">Thêm sản phẩm</a><div class="table-wrap"><table><thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Giá</th><th>Tồn</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Name<br>@p.SKU</td><td>@p.Category?.Name</td><td>@DisplayFormat.Money(p.Price)</td><td>@p.Stock</td><td>@(p.IsActive ? "Đang bán" : "Ngừng bán")</td><td><a asp-action="Edit" asp-route-id="@p.Id">Sửa</a><form asp-action="Delete" method="post" data-confirm="Xóa sản phẩm? Nếu đã có đơn sẽ chuyển ngừng bán."><input name="id" type="hidden" value="@p.Id"><input name="rowVersion" type="hidden" value="@Convert.ToBase64String(p.RowVersion)"><button type="submit">Xóa / Ngừng bán</button></form></td></tr>}</tbody></table></div></main>
