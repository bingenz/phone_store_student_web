@model Order
@{ ViewData["Title"] = "Chi tiết đơn hàng"; }
<main class="container page"><h2>Đơn #@Model.Id</h2><p>@DisplayFormat.Status(Model.Status) · @Model.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</p><p>@Model.Recipient — @Model.Phone</p><p>@Model.Address</p>
<div class="table-wrap"><table><thead><tr><th>Sản phẩm</th><th>Số lượng</th><th>Đơn giá lúc mua</th><th>Thành tiền</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.ProductName (@item.SKU)</td><td>@item.Quantity</td><td>@DisplayFormat.Money(item.UnitPrice)</td><td>@DisplayFormat.Money(item.UnitPrice * item.Quantity)</td></tr>}</tbody></table></div><h3>Tổng: @DisplayFormat.Money(Model.Total)</h3><p>COD · Phí vận chuyển: 0đ.</p></main>
