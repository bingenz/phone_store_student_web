@model List<Order>
@{ ViewData["Title"] = "Đơn hàng"; }
<main class="container page"><h2>Đơn hàng</h2>@if(Model.Count == 0){<p>Chưa có đơn hàng.</p>}
<div class="table-wrap"><table><thead><tr><th>Mã đơn</th><th>Ngày</th><th>Người nhận</th><th>Tổng</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var order in Model){<tr><td><a asp-action="Details" asp-route-id="@order.Id">#@order.Id</a></td><td>@order.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td><td>@order.Recipient</td><td>@DisplayFormat.Money(order.Total)</td><td>@DisplayFormat.Status(order.Status)</td></tr>}</tbody></table></div></main>
