@model List<CartDisplay>
@{ ViewData["Title"] = "Giỏ hàng"; }
<main class="container page"><h2>Giỏ hàng</h2>@if(Model.Count == 0){<p>Giỏ hàng hiện tại đang trống.</p><a href="/Products">Xem sản phẩm</a>}else{
<div class="table-wrap"><table><thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var line in Model){<tr><td><img class="thumb" src="@line.Product.ImagePath" alt=""><a href="/Products/Details/@line.Product.Slug">@line.Product.Name</a>@if(!line.Product.IsActive){<p>Đã ngừng bán — vui lòng xóa khỏi giỏ.</p>}</td><td>@DisplayFormat.Money(line.Product.Price)</td><td><form asp-action="Update" method="post"><input type="hidden" name="id" value="@line.Product.Id"><label>Số lượng<input type="number" name="quantity" min="1" max="999" value="@line.Quantity"></label><button type="submit">Cập nhật</button></form></td><td>@DisplayFormat.Money(line.Product.Price * line.Quantity)</td><td><form asp-action="Update" method="post"><input type="hidden" name="id" value="@line.Product.Id"><input type="hidden" name="quantity" value="0"><button type="submit">Xóa</button></form></td></tr>}
</tbody></table></div><h3>Tổng: @DisplayFormat.Money(Model.Sum(x => x.Product.Price * x.Quantity))</h3><p>COD · Phí vận chuyển demo: 0đ. Giá và tồn kho được kiểm tra lại khi đặt hàng.</p>
<a class="btn btn-primary" href="/Orders/Checkout">Thanh toán</a><form asp-action="Clear" method="post" data-confirm="Xóa toàn bộ giỏ hàng?"><button type="submit">Xóa tất cả</button></form>}</main>
