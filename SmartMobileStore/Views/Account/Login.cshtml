@model LoginInput
@{ ViewData["Title"] = "Đăng nhập"; }
<main class="container page narrow">
    <h2>Đăng nhập</h2>
    <form asp-action="Login" method="post">
        <div asp-validation-summary="All"></div>
        <input asp-for="ReturnUrl" type="hidden">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" autocomplete="email">
        <span asp-validation-for="Email"></span>
        <label asp-for="Password">Mật khẩu</label>
        <div class="password-field">
            <input asp-for="Password" type="password" autocomplete="current-password">
            <button type="button" class="password-toggle" data-password-toggle aria-controls="Password" aria-pressed="false" aria-label="Hiện mật khẩu">Hiện</button>
        </div>
        <span asp-validation-for="Password"></span>
        <button type="submit">Đăng nhập</button>
    </form>
    <a href="/Account/Register">Tạo tài khoản</a>
</main>
