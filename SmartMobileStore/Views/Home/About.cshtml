@{ ViewData["Title"] = "Giới thiệu"; }
<main class="about-section">
        <div class="container">

            <div class="section-title">
                <h2>Giới thiệu SmartMobile</h2>
                <p>Đối tác tin cậy của bạn trong thế giới công nghệ</p>
            </div>

            <!-- Đoạn giới thiệu chính: dùng class .about-intro định nghĩa trong style.css -->
            <div class="about-intro">
                <h3>Chúng tôi là ai?</h3>
                <p>
                    SmartMobile là cửa hàng điện thoại và đồng hồ chính hãng được thành lập
                    với mục tiêu mang đến cho khách hàng những sản phẩm công nghệ chất lượng cao
                    với mức giá hợp lý và dịch vụ hậu mãi tốt nhất.
                </p>
                <p>
                    Chúng tôi hiểu rằng mỗi người có nhu cầu và ngân sách khác nhau,
                    vì vậy SmartMobile luôn cố gắng đa dạng hóa danh mục sản phẩm,
                    từ điện thoại cao cấp như iPhone, Samsung Galaxy Ultra
                    cho đến các dòng tầm trung phù hợp với học sinh, sinh viên.
                </p>
            </div>

            <!-- Điểm mạnh của cửa hàng: dùng ul/li để dễ đọc theo AGENTS.md -->
            <div class="about-intro">
                <h3>Tại sao chọn SmartMobile?</h3>
                <ul class="about-highlight-list">
                    <li>Sản phẩm chính hãng 100% - có hóa đơn, tem bảo hành rõ ràng</li>
                    <li>Bảo hành 12 tháng tại cửa hàng, hỗ trợ đổi trả trong 7 ngày</li>
                    <li>Giá niêm yết minh bạch, không phụ thu phí ẩn</li>
                    <li>Hỗ trợ trả góp 0% lãi suất cho nhiều dòng sản phẩm</li>
                    <li>Đội ngũ tư vấn nhiệt tình, giải đáp trước và sau khi mua</li>
                </ul>
            </div>

            <!-- Thông tin người thực hiện dự án cá nhân -->
            <div class="section-title" style="margin-top: 36px;">
                <h2>Người thực hiện dự án</h2>
                <p>SmartMobile Store là dự án cá nhân phục vụ học tập</p>
            </div>
            <div class="team-list" style="display: block; max-width: 640px; margin: 0 auto;">
                <div class="team-card">
                    <div class="team-avatar">&#128187;</div>
                    <h4>Lê Ngọc Thuận</h4>
                    <p>Người thực hiện duy nhất</p>
                    <p>Phụ trách giao diện, backend, cơ sở dữ liệu, kiểm thử và tài liệu dự án.</p>
                </div>
            </div>

        </div>
    </main>
