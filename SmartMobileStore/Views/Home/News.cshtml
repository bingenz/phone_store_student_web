@{ ViewData["Title"] = "Tin tức minh họa"; }
<p class="container notice">Tin tức và khuyến mãi dưới đây là nội dung minh họa của bài tập.</p>
<main class="news-section">
        <div class="container">

            <div class="section-title">
                <h2>Tin tức &amp; Khuyến mãi</h2>
                <p>Cập nhật thông tin mới nhất từ SmartMobile</p>
            </div>

            <!-- Lưới bài viết: 2 cột trên desktop, 1 cột trên mobile (CSS xử lý) -->
            <div class="news-grid">

                <!-- Bài 1: Khuyến mãi -->
                <article class="news-card">
                    <span class="news-tag">Khuyến mãi</span>
                    <p class="news-date">15/07/2026</p>
                    <h3>Giảm đến 20% cho iPhone 17 Pro trong tháng 7</h3>
                    <p class="news-excerpt">
                        Nhân dịp kỷ niệm ngày thành lập, SmartMobile giảm giá đến 20%
                        cho toàn bộ dòng iPhone 17 Pro. Đây là cơ hội tuyệt vời để sở hữu
                        chiếc điện thoại cao cấp với giá tốt nhất trong năm.
                        Chương trình áp dụng đến hết ngày 31/07/2026.
                    </p>
                </article>

                <!-- Bài 2: Sự kiện -->
                <article class="news-card">
                    <span class="news-tag">Sự kiện</span>
                    <p class="news-date">10/07/2026</p>
                    <h3>SmartMobile mở rộng showroom tại Quận 7</h3>
                    <p class="news-excerpt">
                        Chúng tôi vui mừng thông báo khai trương chi nhánh mới
                        tại Quận 7, TP. Hồ Chí Minh. Chi nhánh mới sẽ phục vụ khách hàng
                        từ 8:00 – 21:00 hàng ngày với đầy đủ các dòng sản phẩm
                        điện thoại và đồng hồ chính hãng.
                    </p>
                </article>

                <!-- Bài 3: Công nghệ -->
                <article class="news-card">
                    <span class="news-tag">Công nghệ</span>
                    <p class="news-date">05/07/2026</p>
                    <h3>Samsung Galaxy A17 - Lựa chọn tầm trung đáng mua nhất 2026</h3>
                    <p class="news-excerpt">
                        Samsung Galaxy A17 vừa ra mắt với nhiều nâng cấp ấn tượng:
                        chip mạnh hơn, pin 5000mAh và màn hình 90Hz.
                        Đây là lựa chọn lý tưởng cho học sinh, sinh viên muốn
                        một chiếc điện thoại bền, lâu dài với ngân sách vừa phải.
                    </p>
                </article>

                <!-- Bài 4: Mẹo dùng -->
                <article class="news-card">
                    <span class="news-tag">Mẹo dùng</span>
                    <p class="news-date">01/07/2026</p>
                    <h3>5 cách bảo vệ điện thoại giúp tăng tuổi thọ pin</h3>
                    <p class="news-excerpt">
                        Pin là bộ phận quan trọng nhất nhưng lại dễ hỏng nhất nếu sử dụng sai cách.
                        Bài viết này tổng hợp 5 thói quen đơn giản giúp bạn bảo vệ pin điện thoại,
                        giữ cho máy luôn hoạt động tốt trong nhiều năm.
                    </p>
                </article>

            </div>
        </div>
    </main>
