@model CatalogView
@{ ViewData["Title"] = "Sản phẩm"; }
<main class="container page"><h2>Sản phẩm SmartMobile</h2>
<form method="get" class="filter-bar"><label>Tìm kiếm<input name="q" value="@Model.Query" maxlength="100" placeholder="Tên sản phẩm hoặc SKU"></label>
<label>Danh mục<select name="category"><option value="">Tất cả</option>@foreach(var c in Model.Categories){<option value="@c.Slug" selected="@(Model.Category == c.Slug)">@c.Name</option>}</select></label>
<label>Sắp xếp<select name="sort"><option value="name" selected="@(Model.Sort == "name")">Tên A–Z</option><option value="price-asc" selected="@(Model.Sort == "price-asc")">Giá tăng</option><option value="price-desc" selected="@(Model.Sort == "price-desc")">Giá giảm</option></select></label><button type="submit">Áp dụng</button></form>
@if(Model.Products.Count == 0){<p>Không tìm thấy sản phẩm phù hợp.</p>}
<div class="product-grid">@foreach(var product in Model.Products){<partial name="_ProductCard" model="product" />}</div>
<nav class="pagination" aria-label="Phân trang">@if(Model.Page > 1){<a asp-action="Index" asp-route-q="@Model.Query" asp-route-category="@Model.Category" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page-1)">Trang trước</a>}<span>Trang @Model.Page / @Model.Pages</span>@if(Model.Page < Model.Pages){<a asp-action="Index" asp-route-q="@Model.Query" asp-route-category="@Model.Category" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page+1)">Trang sau</a>}</nav></main>
